# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

JWT_SECRET=your-jwt-secret
JWT_EXPIRATION=1h

# Frontend base URL used to build links in outgoing emails
APP_BASE_URL=https://www.docsndocs.com

# Dashboard completion credit for a submitted document awaiting owner review.
# 0.25 means 25%; approved documents always receive full credit.
SUBMITTED_COMPLETION_WEIGHT=0.25
