{
  "version": 2,
  "builds": [
    { "src": "app.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "app.js" }
  ],
  "crons": [
    {
      "path": "/api/internal/deadline-reminders",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/internal/stale-project-cleanup",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/internal/stale-project-cleanup",
      "schedule": "30 4 * * *"
    }
  ]
}
