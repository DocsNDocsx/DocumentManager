{
  "name": "docsndocs",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:unit:coverage": "ng test --coverage --watch=false --coverage-reporters=text-summary --coverage-reporters=json-summary",
    "test:backend:coverage": "npm --prefix backend run test:coverage",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:live": "cypress run --config baseUrl=https://www.docsndocs.com,specPattern=cypress/e2e/live/**/*.cy.ts --env apiUrl=https://api.docsndocs.com/api,coverage=false",
    "cypress:run:coverage": "cross-env CYPRESS_coverage=true cypress run --spec cypress/e2e/coverage/**/*.cy.ts",
    "start:coverage:frontend": "cross-env CYPRESS_COVERAGE=true ng run docsndocs:serve-coverage:development",
    "start:coverage:backend": "node scripts/start-backend-coverage.cjs",
    "test:e2e:coverage": "concurrently -k -s first -n backend,frontend,test \"npm run start:coverage:backend\" \"npm run start:coverage:frontend\" \"wait-on http://localhost:3000 http://localhost:4200 && npm run cypress:run:coverage\"",
    "coverage:summary": "node scripts/print-coverage-summary.cjs"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^21.2.19",
    "@angular/compiler": "^21.2.19",
    "@angular/core": "^21.2.19",
    "@angular/forms": "^21.2.19",
    "@angular/platform-browser": "^21.2.19",
    "@angular/router": "^21.2.19",
    "@stripe/stripe-js": "^9.7.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.19",
    "@cypress/code-coverage": "^4.0.3",
    "@docsndocs/angular-builders": "file:tools/angular-builders",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-istanbul": "^8.0.0",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "cypress": "^15.15.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^28.0.0",
    "nyc": "^18.0.0",
    "prettier": "^3.8.1",
    "start-server-and-test": "^3.0.11",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.1.0"
  },
  "nyc": {
    "all": true,
    "extension": [
      ".js",
      ".ts"
    ],
    "include": [
      "backend/**/*.js",
      "src/**/*.ts"
    ],
    "exclude": [
      "backend/tests/**",
      "backend/migrations/**",
      "cypress/**",
      "src/**/*.spec.ts",
      "src/environments/**"
    ],
    "reporter": [
      "html",
      "lcov",
      "text-summary",
      "json-summary"
    ],
    "report-dir": "coverage",
    "cache": false
  },
  "overrides": {
    "@hono/node-server": "^2.0.12",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "brace-expansion": "^5.0.9",
    "esbuild": "^0.28.1"
  }
}
